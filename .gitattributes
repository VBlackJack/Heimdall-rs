# Cross-platform repository: text is stored and checked out with LF everywhere,
# so Windows and Linux builds see identical bytes.
* text=auto eol=lf

# cmd.exe misreads labels and goto in a batch file with LF line ends.
*.bat text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.otf binary
*.ttf binary

# Every change appends its texts at the end of the language files: merged by union, two
# branches adding keys keep both instead of conflicting. A key added twice is refused by
# heimdall-ui's no_language_file_holds_a_key_twice test.
*.ftl merge=union
